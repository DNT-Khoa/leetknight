{
  "name": "leetknight",
  "displayName": "LeetKnight",
  "description": "Scaffold, test, and submit LeetCode problems in Java from VS Code — with an Anki-inspired rating step that drives a hardest-first practice queue.",
  "version": "1.0.0",
  "publisher": "khoa-doan",
  "author": {
    "name": "Khoa Doan"
  },
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/DNT-Khoa/leetknight.git"
  },
  "bugs": {
    "url": "https://github.com/DNT-Khoa/leetknight/issues"
  },
  "homepage": "https://github.com/DNT-Khoa/leetknight#readme",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "keywords": [
    "leetcode",
    "java",
    "interview-prep",
    "spaced-repetition"
  ],
  "categories": [
    "Programming Languages",
    "Testing"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "activationEvents": [
    "workspaceContains:.leetknight/reviews.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "leetknight.init",
        "title": "LeetKnight: Initialize Workspace"
      },
      {
        "command": "leetknight.newProblem",
        "title": "LeetKnight: New Problem from URL"
      },
      {
        "command": "leetknight.searchLeetcode",
        "title": "LeetKnight: Search LeetCode"
      },
      {
        "command": "leetknight.runTests",
        "title": "LeetKnight: Run Tests",
        "icon": "$(play)"
      },
      {
        "command": "leetknight.submit",
        "title": "LeetKnight: Submit",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "leetknight.resetProblem",
        "title": "LeetKnight: Reset Problem",
        "icon": "$(discard)"
      },
      {
        "command": "leetknight.pickRandom",
        "title": "LeetKnight: Pick Random Practice Problem",
        "icon": "$(getting-started-beginner)"
      },
      {
        "command": "leetknight.setLeetcodeCookies",
        "title": "LeetKnight: Set LeetCode Cookies"
      },
      {
        "command": "leetknight.runPlayground",
        "title": "LeetKnight: Run Playground",
        "icon": "$(play-circle)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "leetknight",
          "title": "LeetKnight",
          "icon": "media/icon-sidebar.svg"
        }
      ]
    },
    "views": {
      "leetknight": [
        {
          "id": "leetknight.practice",
          "name": "Practice"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "leetknight.runTests",
          "when": "leetknight.activeIsProblem"
        },
        {
          "command": "leetknight.submit",
          "when": "leetknight.activeIsProblem"
        },
        {
          "command": "leetknight.resetProblem",
          "when": "leetknight.activeIsProblem"
        },
        {
          "command": "leetknight.runPlayground",
          "when": "leetknight.activeIsPlayground"
        }
      ],
      "editor/title": [
        {
          "command": "leetknight.runTests",
          "when": "leetknight.activeIsProblem",
          "group": "navigation@1"
        },
        {
          "command": "leetknight.submit",
          "when": "leetknight.activeIsProblem",
          "group": "navigation@2"
        },
        {
          "command": "leetknight.resetProblem",
          "when": "leetknight.activeIsProblem",
          "group": "navigation@3"
        },
        {
          "command": "leetknight.runPlayground",
          "when": "leetknight.activeIsPlayground",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "leetknight.pickRandom",
          "when": "view == leetknight.practice",
          "group": "navigation@1"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.4.0"
  }
}
